# FIN-07 AML Console — biến môi trường frontend
# Sao chép thành .env (không commit .env chứa giá trị thật).

# Địa chỉ backend FastAPI khi frontend gọi API thật (production).
# Frontend hiện chạy hoàn toàn bằng mock data nên biến này CHƯA được sử dụng
# trong mã nguồn — chuẩn bị sẵn cho giai đoạn nối API (epic E09 ↔ backend).
VITE_API_BASE_URL=https://api.amlmonitoring.site

# Đích proxy /api khi chạy `npm run dev` ngoài Docker (chỉ dùng ở máy dev).
VITE_API_TARGET=http://localhost:8000
