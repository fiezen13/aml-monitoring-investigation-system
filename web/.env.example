# FIN-07 AML Console — biến môi trường frontend
# Sao chép thành .env (không commit .env chứa giá trị thật).

# Địa chỉ backend FastAPI khi frontend gọi API thật.
# ĐÃ được dùng trong mã nguồn (web/src/api/client.ts) — mọi trang gọi thẳng
# API thật qua src/api/routes.py và fc_routes.py, không còn mock data nào
# trong web/src/. Để trống thì request là same-origin (/api/v1/...) — đúng
# khi nginx/web container proxy /api sang api container (xem web/nginx.conf).
# Chỉ cần đặt biến này khi frontend và backend khác origin (vd. deploy tĩnh
# trên Vercel thay vì qua nginx proxy).
VITE_API_BASE_URL=https://api.amlmonitoring.site

# Đích proxy /api khi chạy `npm run dev` ngoài Docker (chỉ dùng ở máy dev).
VITE_API_TARGET=http://localhost:8000
