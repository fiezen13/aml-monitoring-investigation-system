{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fin07.local/contracts/canonical/business.v1.schema.json",
  "title": "ABM-BANK canonical BUSINESS v1",
  "description": "A synthetic legal or household-business entity visible to a Level-1 bank through KYC, merchant, employer, or counterparty data. Hidden ownership and criminal-network membership are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "business_id",
    "source_refs",
    "business_type",
    "industry_code",
    "status",
    "created_at",
    "valid_from"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "business_id": { "type": "string", "pattern": "^BUS-[A-Za-z0-9_-]+$", "maxLength": 128 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/source_ref" }
    },
    "business_type": {
      "type": "string",
      "enum": ["HOUSEHOLD_BUSINESS", "PRIVATE_ENTERPRISE", "PARTNERSHIP", "LIMITED_LIABILITY", "JOINT_STOCK", "COOPERATIVE", "FINANCIAL_INSTITUTION", "OTHER"]
    },
    "industry_code": { "type": "string", "maxLength": 32 },
    "legal_form_code": { "type": "string", "maxLength": 32 },
    "employee_count_band": { "type": "string", "maxLength": 32 },
    "annual_turnover_band": { "type": "string", "maxLength": 64 },
    "registered_country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "registered_region_code": { "type": "string", "maxLength": 32 },
    "established_at": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/timestamp" },
    "status": { "type": "string", "enum": ["ACTIVE", "TEMPORARILY_INACTIVE", "DISSOLVING", "DISSOLVED", "UNKNOWN"] },
    "created_at": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/timestamp" },
    "valid_from": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/timestamp" },
    "valid_to": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/timestamp" },
    "provenance": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/provenance" },
    "data_class": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/data_class" }
  }
}
