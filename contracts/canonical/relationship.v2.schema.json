{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fin07.local/contracts/canonical/relationship.v2.schema.json",
  "title": "ABM-BANK canonical RELATIONSHIP v2",
  "description": "Versioned, point-in-time Bank View relationship proposal. All inferred edges carry method, confidence, provenance, and supporting logic; hidden coordination is forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relationship_id",
    "source_entity",
    "target_entity",
    "relationship_type",
    "direction",
    "method",
    "confidence",
    "created_at",
    "valid_from",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0" },
    "relationship_id": { "type": "string", "pattern": "^REL-[A-Za-z0-9_-]+$", "maxLength": 128 },
    "source_entity": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/entity_ref" },
    "target_entity": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/entity_ref" },
    "relationship_type": {
      "type": "string",
      "enum": [
        "OWNS_ACCOUNT",
        "CO_OWNS_ACCOUNT",
        "OWNS_BUSINESS",
        "BENEFICIAL_OWNER",
        "AUTHORIZED_SIGNATORY",
        "EMPLOYED_BY",
        "USES_DEVICE",
        "SHARED_DEVICE",
        "SHARED_IP",
        "SHARED_CONTACT",
        "SHARED_ADDRESS",
        "KNOWN_BENEFICIARY",
        "MERCHANT_OPERATED_BY",
        "TRANSACTED_WITH",
        "RESOLVED_SAME_PERSON"
      ]
    },
    "direction": { "type": "string", "enum": ["DIRECTED", "UNDIRECTED"] },
    "method": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/resolution_method" },
    "confidence": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/confidence" },
    "is_fact": { "type": "boolean" },
    "inference_logic": { "type": "string", "maxLength": 2048 },
    "observation_count": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/timestamp" },
    "valid_from": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/timestamp" },
    "valid_to": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/timestamp" },
    "provenance": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/provenance" },
    "data_class": { "$ref": "https://fin07.local/contracts/common/common.v1.schema.json#/$defs/data_class" }
  },
  "allOf": [
    {
      "if": { "properties": { "is_fact": { "const": true } }, "required": ["is_fact"] },
      "then": { "properties": { "method": { "enum": ["DETERMINISTIC", "ANALYST_CONFIRMED"] } } }
    },
    {
      "if": { "properties": { "method": { "const": "PROBABILISTIC" } }, "required": ["method"] },
      "then": { "required": ["inference_logic"] }
    }
  ]
}
