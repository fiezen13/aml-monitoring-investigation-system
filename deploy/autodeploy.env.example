# Cấu hình cho deploy/autodeploy.sh. Đặt tại /etc/fin07/autodeploy.env,
# quyền 600 — file này chứa token.
#
#   sudo install -d -m 700 /etc/fin07
#   sudo install -m 600 deploy/autodeploy.env.example /etc/fin07/autodeploy.env
#   sudo nano /etc/fin07/autodeploy.env

# Kho mã nguồn, dạng chu-so-huu/ten-repo.
GITHUB_REPO=AI20K-Build-Phase-Cohort-3/P-022

# Token chỉ đọc, tạo tại https://github.com/settings/personal-access-tokens
#
# Dùng fine-grained token, chọn đúng repo này, và chỉ hai quyền đọc:
#   Contents: Read-only   — để kéo mã nguồn
#   Metadata: Read-only   — bắt buộc, GitHub tự thêm
#   Actions:  Read-only   — để đọc kết quả CI
#
# Token do *cá nhân* tạo nên không cần quyền Admin trên repo. Đặt hạn dùng và
# ghi lịch thay token trước ngày hết hạn: hết hạn thì việc triển khai lặng lẽ
# dừng, và không có gì trên giao diện báo điều đó.
GITHUB_TOKEN=ghp_thay_bang_token_that

# Nhánh phát hành. Chỉ nhánh này mới lên production.
#
# Đang là develop chứ không phải main, và đó là lựa chọn có chủ đích: tính tới
# giữa tháng 8/2026, main còn lùi 110 commit so với develop. Trỏ vào main lúc
# này sẽ ghi đè production bằng một bản cũ. Chuyển sang main sau khi gộp
# develop vào main ở cuối chương trình — và chỉ sau khi đã kiểm chứng CI xanh
# trên main.
DEPLOY_BRANCH=develop

# Nơi mã nguồn được nhân bản trên máy chủ. Không trỏ vào thư mục làm việc của
# người dùng: script chạy `git clean -fdx` và sẽ xoá mọi thứ không thuộc repo.
APP_DIR=/opt/fin07/app

# Tên miền dùng cho kiểm tra khói sau khi triển khai.
SMOKE_URL=https://www.amlmonitoring.site
