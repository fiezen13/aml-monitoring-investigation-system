# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
.metals/
.claude/settings.local.json
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
data/*
# `artifacts/*` chứ không phải `artifacts/`: git không đi vào một thư mục đã bị
# loại, nên viết `artifacts/` thì mọi ngoại lệ bên dưới đều vô hiệu.
artifacts/*
# Ngoại lệ: kết quả EDA là báo cáo, không phải dữ liệu. Vài chục KB, và tài
# liệu docs/ml/ trích số liệu cùng checksum từ đây — có nó trong repo thì
# người đọc kiểm chứng được mà không cần tải bộ dữ liệu 650 MB.
!artifacts/eda/
artifacts/eda/*
!artifacts/eda/*.json
simulation_output/
*.parquet
*.db
*.sqlite3

# Graph handoff payloads distributed through Drive (checksums in manifest).
# Git chỉ giữ model nhỏ, manifest và đặc tả; mọi bảng/evidence đều ở ngoài Git.
/graph_handoff/*.parquet
/graph_handoff/*.jsonl

# Isolation Forest handoff payloads copied from Drive. Keep the compact model,
# manifest and documentation reviewable; tables stay outside Git and are
# verified by checksum before a fusion release.
/if_handoff/*.parquet

# Bộ dữ liệu IBM AML nặng từ hàng trăm megabyte tới hàng chục gigabyte và
# tải về từ Kaggle, không commit. Nhưng thư mục và hướng dẫn đặt file thì
# phải có sẵn, nếu không người mới sẽ không biết đặt file vào đâu.
!data/README.md
!data/raw/
data/raw/*
!data/raw/ibm-aml/
data/raw/ibm-aml/*
!data/raw/ibm-aml/.gitkeep
!data/raw/ibm-aml/README.md

# Bảng tra cứu do dự án soạn, không phải dữ liệu tải về: ánh xạ tên ngân hàng
# sang mã quốc gia và toạ độ vẽ bản đồ. Thiếu nó thì
# scripts/load_bank_geography.py không chạy được trên bản clone mới.
!data/reference/
!data/reference/*.csv

# Sổ đăng ký nguồn dữ liệu công khai. Đây là bằng chứng xuất xứ của mọi tham số
# sinh dữ liệu, không phải dữ liệu sinh ra — phải nằm trong Git.
!data/source_registry/
!data/source_registry/**

# Khoá API Kaggle — không bao giờ nằm trong repo.
kaggle.json
.kaggle/

# Sản phẩm build của job Flink
flink/**/target/

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/
.ai-log/local-backup/

# Jenkins — bí mật của controller
jenkins/.env

# CI — sản phẩm trung gian
.image-tags
pytest-report.xml
.gstack/
.github/modernize/

# Artifact của công cụ thiết kế trong docs/design/prototype/.
#
# Bản thân prototype (HTML + các engine .js) được commit để giữ nguồn gốc cho
# phần vendor ở web/src/vendor/fc/. Nhưng ảnh chụp dán vào lúc thiết kế và file
# preview thì nặng 3,4 MB, không file nào tham chiếu tới, và không dựng lại
# được gì từ chúng.
docs/design/prototype/uploads/
docs/design/prototype/.thumbnail

# Terraform — state CHỨA MẬT KHẨU CƠ SỞ DỮ LIỆU dạng chữ thường.
#
# Bỏ qua state không phải để repo gọn, mà vì commit nó là công bố mật khẩu cho
# mọi người có quyền đọc repo, vĩnh viễn — git không quên. Cũng bỏ qua .tfvars
# vì nó chứa định danh dự án, và thư mục .terraform vì nó nặng và dựng lại được
# bằng `terraform init`.
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
infra/terraform/crash.log

# MEGA-PNA checkpoints and per-edge scores are reproducible, machine-specific
# benchmark artifacts. Commit the compact JSON reports, not model/data payloads.
/models/mega-pna/**/*.pt
/models/mega-pna/**/*.parquet
