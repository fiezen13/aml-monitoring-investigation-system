# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
data/
*.db
*.sqlite3

# Bộ dữ liệu IBM AML nặng từ hàng trăm megabyte tới hàng chục gigabyte và
# tải về từ Kaggle, không commit. Nhưng thư mục và hướng dẫn đặt file thì
# phải có sẵn, nếu không người mới sẽ không biết đặt file vào đâu.
!data/
data/*
!data/raw/
data/raw/*
!data/raw/ibm-aml/
data/raw/ibm-aml/*
!data/raw/ibm-aml/.gitkeep
!data/raw/ibm-aml/README.md

# Khoá API Kaggle — không bao giờ nằm trong repo.
kaggle.json
.kaggle/

# Sản phẩm build của job Flink
flink/**/target/

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/

# Jenkins — bí mật của controller
jenkins/.env

# CI — sản phẩm trung gian
.image-tags
pytest-report.xml
.gstack/

# Artifact của công cụ thiết kế trong docs/design/prototype/.
#
# Bản thân prototype (HTML + các engine .js) được commit để giữ nguồn gốc cho
# phần vendor ở web/src/vendor/fc/. Nhưng ảnh chụp dán vào lúc thiết kế và file
# preview thì nặng 3,4 MB, không file nào tham chiếu tới, và không dựng lại
# được gì từ chúng.
docs/design/prototype/uploads/
docs/design/prototype/.thumbnail
