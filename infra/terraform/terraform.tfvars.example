# Sao chép thành terraform.tfvars rồi điền. File thật KHÔNG commit.
#
#   cp terraform.tfvars.example terraform.tfvars

# Bắt buộc -----------------------------------------------------------
project_id = "thay-bang-id-du-an-cua-ban"
vm_name    = "thay-bang-ten-vm-dang-chay"

# Phải cùng vùng với VM, nếu không IP tĩnh không gán được -------------
region = "us-central1"
zone   = "us-central1-a"

# Tuỳ chọn -----------------------------------------------------------
site_domain = "amlmonitoring.site"
db_tier     = "db-f1-micro"

# Cloud SQL song song cho MEGA-PNA HI-Medium -------------------------
# Mặc định phục vụ test split (~5,87 triệu giao dịch). Nếu chủ đích score
# toàn bộ graph, dùng db-custom-4-15360, disk 150 GB và autoresize 300 GB.
hi_medium_db_instance_name             = "fin07-hi-medium-v1"
hi_medium_db_tier                      = "db-custom-2-7680"
hi_medium_db_disk_size_gb              = 50
hi_medium_db_disk_autoresize_limit_gb  = 100
hi_medium_db_deletion_protection       = true
