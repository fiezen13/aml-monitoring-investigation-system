# cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars nằm trong .gitignore: nó chứa IP nhà anh và tên profile
# AWS, không phải thứ để công khai trong repo.

# Profile trong ~/.aws/credentials.
# Nên là một IAM user riêng cho terraform, KHÔNG phải khoá của tài khoản root.
aws_profile = "fin07-terraform"

region = "ap-southeast-1"

# Lấy IP hiện tại:
#
#     curl -s https://checkip.amazonaws.com
#
# ĐỪNG dùng ifconfig.me hay whatismyip. Nhà mạng có thể đi ra bằng nhiều IP
# khác nhau tuỳ đích đến: một dịch vụ báo 123.x, nhưng AWS lại nhìn thấy 14.x,
# và security group mở cho đúng cái IP sai. Triệu chứng là SSH timeout trong
# khi mọi thứ trên AWS đều đúng — mất cả buổi mới tìm ra.
# checkip.amazonaws.com chạy trên chính AWS nên nó thấy đúng cái AWS thấy.
#
# Nhà dùng IP động thì đổi IP là mất kết nối — sửa dòng này rồi apply lại.
allowed_cidr_blocks = ["1.2.3.4/32"]

ssh_public_key_path = "~/Downloads/fin07_ci.pub"

# t3.large = 2 vCPU, 8 GB. Hạ xuống t3.medium để tiết kiệm nếu chấp nhận chật.
instance_type  = "t3.large"
root_volume_gb = 50
