# Bí mật của Jenkins controller.
#
#   cp .env.example .env
#
# File .env trong thư mục này nằm trong .gitignore. Không commit.
#
# Đây là cách nạp bí mật cho môi trường phát triển và cho controller tự host
# của nhóm. Khi bàn giao cho tổ chức thật, thay khối này bằng kho bí mật của
# họ (Vault, AWS Secrets Manager, hoặc tương đương) — JCasC đọc biến môi
# trường nên chỉ cần đổi nguồn tiêm biến, không phải sửa casc.yaml.

# ---- Tài khoản quản trị Jenkins ----
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
JENKINS_URL=http://localhost:8080/
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000

# ---- Agent ----
# Bỏ trống ở lần khởi động đầu. Sau khi controller lên, vào
# http://localhost:8080/computer/fin07-agent-1/ để lấy secret rồi điền vào đây.
JENKINS_AGENT_SECRET=

# Nhóm sở hữu /var/run/docker.sock trên MÁY CHỦ. Lấy bằng:
#     stat -c '%g' /var/run/docker.sock
# Debian thường 999, Ubuntu 24.04 thường 988 — không có số nào đúng cho mọi
# máy. Đặt sai thì mọi lệnh docker trong pipeline báo "permission denied
# while trying to connect to the docker API".
DOCKER_GID=999

# ---- Registry (GHCR) ----
# REGISTRY_TOKEN là Personal Access Token có quyền write:packages.
REGISTRY_USER=
REGISTRY_TOKEN=

# ---- GitHub (đọc mã nguồn, báo trạng thái về pull request) ----
# GITHUB_TOKEN cần quyền repo:status và đọc repo.
GITHUB_USER=
GITHUB_TOKEN=

# ---- Staging ----
STAGING_POSTGRES_PASSWORD=
STAGING_AGENT_DB_PASSWORD=
STAGING_GOOGLE_API_KEY=

# ---- Production-like ----
# KHÔNG dùng lại mật khẩu của staging. Hai môi trường chung mật khẩu thì
# việc tách chúng ra chỉ còn là hình thức.
PRODLIKE_POSTGRES_PASSWORD=
PRODLIKE_AGENT_DB_PASSWORD=
PRODLIKE_GOOGLE_API_KEY=
