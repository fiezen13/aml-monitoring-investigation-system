# =====================================================================
# FIN-07 — Biến môi trường
#
#   cp .env.example .env
#
# KHÔNG bắt buộc phải có .env để chạy `docker compose up`: mọi biến dưới
# đây đều đã có giá trị mặc định cho môi trường phát triển ngay trong
# docker-compose.yml. File .env chỉ dùng để ghi đè.
#
# Giải thích đầy đủ từng biến — ai đọc, ảnh hưởng gì, đổi khi nào:
#   docs/ENVIRONMENT.md
#
# .env nằm trong .gitignore. Không commit. Không dán vào chat.
# =====================================================================

# ---- Ứng dụng -------------------------------------------------------
APP_NAME=FIN-07 AML Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ---- Cổng phát ra máy chủ (đổi khi cổng đã bị chiếm) -----------------
API_PORT=8000
WEB_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- PostgreSQL -----------------------------------------------------
POSTGRES_USER=fin07
POSTGRES_PASSWORD=fin07_dev_password
POSTGRES_DB=fin07
# Vai trò chỉ đọc của agent (QD1, NT5). Chỉ đọc được schema `agent`,
# không chạm được schema `label`.
FIN07_AGENT_DB_PASSWORD=fin07_agent_dev_password
# Chuỗi kết nối. Trong Docker host là `postgres`; chạy ngoài Docker đổi
# thành localhost.
DATABASE_URL=postgresql+psycopg://fin07:fin07_dev_password@localhost:5432/fin07
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

# ---- Redis và worker ------------------------------------------------
REDIS_URL=redis://localhost:6379/0
WORKER_QUEUE=fin07:jobs
WORKER_POLL_INTERVAL=1.0
WORKER_HEARTBEAT_KEY=fin07:worker:heartbeat
WORKER_HEARTBEAT_TTL=30

# ---- Mô hình ngôn ngữ -----------------------------------------------
# Nhà cung cấp hiện dùng là Google Gemini.
GOOGLE_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.7

# ---- Dữ liệu mẫu ----------------------------------------------------
# Cùng SEED_VALUE cho ra cùng dữ liệu, kể cả mốc thời gian (ND5).
SEED_VALUE=20260728
SEED_CUSTOMERS=48
SEED_DAYS=90

# ---- Vector store ---------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma

# ---- Tên image (CI ghi đè bằng tag của registry) ---------------------
APP_IMAGE=fin07/app:local
WEB_IMAGE=fin07/web:local

# ---- LangSmith (nhật ký AI — hạng mục bàn giao #4) -------------------
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fin07-aml-agent
LANGCHAIN_TRACING_V2=false

# ---- Nhật ký AI hook (do giảng viên cung cấp) ------------------------
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log
