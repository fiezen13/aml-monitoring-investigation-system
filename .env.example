# =====================================================================
# FIN-07 — Biến môi trường
#
#   cp .env.example .env
#
# KHÔNG bắt buộc phải có .env để chạy `docker compose up`: mọi biến dưới
# đây đều đã có giá trị mặc định cho môi trường phát triển ngay trong
# docker-compose.yml. File .env chỉ dùng để ghi đè.
#
# FILE NÀY LÀ TÀI LIỆU BIẾN MÔI TRƯỜNG DUY NHẤT. Giải thích của mỗi biến nằm
# ngay trên dòng khai báo nó. Thêm biến mới thì thêm cả chú thích — một biến
# không ai giải thích là một biến không ai dám đổi.
#
# tests/test_config_documented.py bắt buộc: mọi trường của Settings/AmlSettings
# và mọi ${BIEN} trong docker-compose.yml đều phải có mặt ở đây.
#
# .env nằm trong .gitignore. Không commit. Không dán vào chat.
# =====================================================================

# ---- Ứng dụng -------------------------------------------------------
APP_NAME=FIN-07 AML Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ---- VM production -------------------------------------------------
# Bắt buộc khi chạy deploy/vm-deploy.sh. Không cần cho môi trường local.
SITE_DOMAIN=amlmonitoring.site
ACME_EMAIL=

# ---- Cổng phát ra máy chủ (đổi khi cổng đã bị chiếm) -----------------
API_PORT=8000
WEB_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- PostgreSQL -----------------------------------------------------
POSTGRES_USER=fin07
POSTGRES_PASSWORD=fin07_dev_password
POSTGRES_DB=fin07
# Vai trò chỉ đọc của agent (QD1, NT5). Chỉ đọc được schema `agent`,
# không chạm được schema `label`.
FIN07_AGENT_DB_PASSWORD=fin07_agent_dev_password
# Chuỗi kết nối. Trong Docker host là `postgres`; chạy ngoài Docker đổi
# thành localhost.
DATABASE_URL=postgresql+psycopg://fin07:fin07_dev_password@localhost:5432/fin07
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

# ---- Redis và worker ------------------------------------------------
REDIS_URL=redis://localhost:6379/0
WORKER_QUEUE=fin07:jobs
WORKER_POLL_INTERVAL=1.0
WORKER_HEARTBEAT_KEY=fin07:worker:heartbeat
WORKER_HEARTBEAT_TTL=30

# ---- Mô hình ngôn ngữ -----------------------------------------------
# Nhà cung cấp hiện dùng là Google Gemini.
GOOGLE_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.7

# ---- Dữ liệu mẫu ----------------------------------------------------
# Cùng SEED_VALUE cho ra cùng dữ liệu, kể cả mốc thời gian (ND5).
SEED_VALUE=20260728
SEED_CUSTOMERS=48
SEED_DAYS=90

# ---- Vector store ---------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma

# =====================================================================
# Luồng nạp dữ liệu AML: CSV IBM AML → Kafka → Flink → HDFS
#
# Chỉ cần khi làm việc với profile `aml`:
#   docker compose --profile aml up -d --wait
#
# Không biến nào bắt buộc — mặc định chạy được với HI-Small đặt ở
# data/raw/ibm-aml/. Bối cảnh đường ống: contracts/ingestion/README.md.
# =====================================================================

# ---- Nguồn dữ liệu --------------------------------------------------
# Đường dẫn khi chạy producer từ máy chủ.
AML_CSV_PATH=data/raw/ibm-aml/HI-Small_Trans.csv
# Thư mục và tên file khi chạy producer trong container. Đổi hai biến này
# để chuyển sang LI-Small, HI-Medium, HI-Large…
AML_DATASET_DIR=./data/raw/ibm-aml
AML_DATASET_FILE=HI-Small_Trans.csv
# Để trống thì suy ra từ tên file: HI-Small_Trans.csv → HI-Small.
AML_SOURCE_DATASET=
# Múi giờ để hiểu cột Timestamp của bộ dữ liệu. Bộ dữ liệu không ghi múi
# giờ; đây là giả định được khai báo, không phải suy đoán.
DATASET_TIMEZONE=UTC

# ---- Kafka ----------------------------------------------------------
# Từ máy chủ: localhost:29092. Trong mạng compose: kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
AML_KAFKA_PORT=29092
AML_KAFKA_CLUSTER_ID=fin07-aml-local-cluster
AML_KAFKA_RETENTION_HOURS=168
AML_RAW_TOPIC=aml.transactions.raw.v1
AML_DLQ_TOPIC=aml.transactions.dlq.v1
AML_TOPIC_PARTITIONS=3
# Một broker thì chỉ nhân bản được một lần.
AML_TOPIC_REPLICATION_FACTOR=1
AML_TOPIC_RETENTION_MS=604800000
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_LINGER_MS=20
KAFKA_BATCH_SIZE=262144
KAFKA_QUEUE_BUFFERING_MAX_MESSAGES=100000
KAFKA_MESSAGE_TIMEOUT_MS=120000

# ---- Giao diện xem Kafka (chỉ quan sát, không nằm trên đường dữ liệu) -
# http://localhost:8082 — topic, offset, consumer lag, nội dung message.
AML_KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0
AML_KAFKA_UI_PORT=8082
AML_KAFKA_UI_CLUSTER_NAME=fin07-aml

# ---- Chế độ phát lại ------------------------------------------------
# max-throughput | event-time
REPLAY_MODE=max-throughput
REPLAY_SPEED_MULTIPLIER=1.0
REPLAY_MAX_SLEEP_SECONDS=5.0

# ---- Giới hạn dữ liệu khi phát triển (0 hoặc rỗng = không giới hạn) --
MAX_RECORDS=0
START_LINE=0
END_LINE=0
FROM_TIMESTAMP=
TO_TIMESTAMP=

# ---- Điểm dừng và dòng lỗi ------------------------------------------
AML_CHECKPOINT_ENABLED=true
AML_CHECKPOINT_PATH=data/aml/checkpoints/producer.json
AML_CHECKPOINT_INTERVAL_SECONDS=5.0
AML_RESUME=true
AML_DLQ_ENABLED=true
AML_ERROR_LOG_PATH=data/aml/rejected/producer-errors.jsonl
AML_PROGRESS_EVERY_SECONDS=10.0
AML_LOG_LEVEL=INFO

# ---- Flink ----------------------------------------------------------
AML_FLINK_IMAGE=fin07/flink-aml:local
# Dockerfile dùng để build image Flink. Đổi khi cần dùng một Dockerfile tùy chỉnh.
AML_FLINK_DOCKERFILE=docker/flink/Dockerfile
AML_FLINK_UI_PORT=8081
AML_FLINK_PARALLELISM=2
AML_FLINK_TASK_SLOTS=4
# Consumer group của job. Đổi giá trị này là bắt đầu đọc lại từ đầu topic.
AML_FLINK_GROUP_ID=aml-hdfs-ingestion-v1
# Vị trí đọc khi group chưa có offset đã commit: earliest | latest | none.
AML_KAFKA_OFFSET_RESET=earliest
# Nhịp checkpoint. Với Parquet, đây CŨNG là thứ quyết định kích thước file:
# file chỉ được chốt tại checkpoint.
AML_CHECKPOINT_INTERVAL_MS=30000
# Mức trễ tối đa watermark cho phép. Chưa có cửa sổ nào dùng tới, nhưng trục
# thời gian phải đúng ngay từ lúc nạp.
AML_WATERMARK_OUT_OF_ORDER_SECONDS=120

# Bảy biến dưới đây được JobConfig.java đọc THẲNG từ biến môi trường của
# container Flink, không đi qua interpolation ${...} của docker-compose.yml.
# Hệ quả: tests/test_config_documented.py không nhìn thấy chúng, nên sửa
# JobConfig.java mà quên cập nhật ở đây sẽ KHÔNG làm CI đỏ. Đây là điểm mù đã
# biết — cập nhật bằng tay khi đổi.
# Sau bao lâu một partition không có dữ liệu mới thì bị coi là idle, để
# watermark của các partition khác không bị nó chặn lại.
AML_WATERMARK_IDLE_SECONDS=60
# Số lần Flink tự khởi động lại job khi task fail, trước khi bỏ cuộc.
AML_RESTART_ATTEMPTS=10
AML_RESTART_DELAY_SECONDS=10
# Phiên bản schema mà TransactionValidator yêu cầu khớp. Sự kiện mang
# schema_version khác giá trị này bị coi là không hợp lệ.
AML_SCHEMA_VERSION=1.0
# Ba biến rollover CHỈ áp dụng khi AML_HDFS_FORMAT=json. Parquet dùng
# OnCheckpointRollingPolicy và không đọc chúng.
AML_ROLLOVER_INTERVAL_MS=300000
AML_ROLLOVER_INACTIVITY_MS=120000
AML_ROLLOVER_MAX_MB=128

# ---- HDFS -----------------------------------------------------------
AML_HDFS_BASE_PATH=hdfs://namenode:8020/data/aml
# parquet | json
AML_HDFS_FORMAT=parquet
AML_HDFS_UI_PORT=9870

# ---- Cloud SQL thay cho container postgres ---------------------------
# Đặt true để deploy/vm-deploy.sh thêm lớp phủ deploy/docker-compose.cloudsql.yml:
# container postgres không dựng, ba service ứng dụng nối thẳng tới Cloud SQL.
#
# Khi true thì DATABASE_URL là bắt buộc và POSTGRES_PASSWORD không còn tác dụng.
# Lấy chuỗi kết nối:  cd infra/terraform && terraform output -raw database_url
# Quy trình đầy đủ:   docs/operations/GCP_SETUP.md
USE_CLOUD_SQL=false

# ---- Giám sát (profile `obs`) ----------------------------------------
# Prometheus + Grafana + bốn exporter. Không nằm trên đường phục vụ người
# dùng: tắt hết cụm này thì hệ thống vẫn chạy y nguyên.
#
# Cả hai cổng bind vào 127.0.0.1, KHÔNG ra Internet. Trên VM xem bằng đường
# hầm SSH — xem docs/operations/MONITORING.md.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
# ĐỔI trước khi dùng ở môi trường có người khác truy cập được.
GRAFANA_ADMIN_PASSWORD=admin
# Chuỗi kết nối cho postgres-exporter. Khác DATABASE_URL ở chỗ KHÔNG có tiền
# tố `+psycopg`: exporter dùng libpq, không hiểu cú pháp của SQLAlchemy.
#   Cloud SQL:  postgresql://fin07:<mật khẩu>@<ip>:5432/fin07?sslmode=require
MONITORING_PG_DSN=postgresql://fin07:fin07_dev_password@postgres:5432/fin07?sslmode=disable
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.3.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.62.0
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.15.0

# ---- Tên image (CI ghi đè bằng tag của registry) ---------------------
APP_IMAGE=fin07/app:local
WEB_IMAGE=fin07/web:local

# ---- LangSmith (nhật ký AI — hạng mục bàn giao #4) -------------------
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fin07-aml-agent
LANGCHAIN_TRACING_V2=false

# ---- Nhật ký AI hook (do giảng viên cung cấp) ------------------------
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# Obtain this value through the private course/team channel. Never commit it.
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
