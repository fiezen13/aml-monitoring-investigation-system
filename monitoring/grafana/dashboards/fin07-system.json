{
  "uid": "fin07-system",
  "title": "FIN-07 · Hệ thống",
  "tags": [
    "fin07",
    "system"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "1 · Sức khoẻ",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Thành phần đang sống",
      "description": "Số mục tiêu Prometheus cào được trên tổng số. Tụt xuống là có thứ đã chết.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "sống",
          "expr": "sum(up)"
        },
        {
          "refId": "B",
          "legendFormat": "tổng",
          "expr": "count(up)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Yêu cầu đang xử lý",
      "description": "Số request HTTP đang chạy dở. Tăng vọt mà độ trễ cũng tăng nghĩa là đang nghẽn.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "đang chạy",
          "expr": "sum(fin07_http_active_requests)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tỷ lệ lỗi 5xx",
      "description": "Phần trăm request trả về lỗi máy chủ trong 5 phút gần nhất.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "5xx %",
          "expr": "100 * (sum(rate(fin07_http_requests_total{status_class=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(fin07_http_requests_total[5m])), 0.001)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Độ trễ P95 hiện tại",
      "description": "Nhịp phản hồi thực tế người dùng đang chịu.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fin07_http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "type": "row",
      "title": "2 · Độ trễ API",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Độ trễ HTTP P50 / P95 / P99",
      "description": "Thời gian máy chủ xử lý một request, đo bằng middleware ở src/observability/http.py. Đây là độ trễ THẬT của hệ thống, khác với độ trễ gọi mô hình AI ở bảng Tác tử.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fin07_http_request_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fin07_http_request_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fin07_http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "8 đường chậm nhất (P95)",
      "description": "Xếp hạng theo route để biết CHỖ NÀO chậm, không chỉ biết là chậm.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{route}}",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(fin07_http_request_duration_seconds_bucket[5m]))))"
        }
      ]
    },
    {
      "type": "row",
      "title": "3 · Lưu lượng và lỗi",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Request mỗi giây theo đường",
      "description": "8 route bận nhất. Đọc cùng bảng độ trễ để phân biệt chậm-vì-tải và chậm-vì-lỗi.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
