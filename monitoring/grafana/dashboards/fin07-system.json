      "type": "timeseries",
      "title": "Request mỗi giây theo nhóm mã trả về",
      "description": "2xx/4xx/5xx tách riêng. 4xx tăng thường là lỗi phía người dùng hoặc quyền, 5xx là lỗi của ta.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
